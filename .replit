modules = ["nodejs-20", "web"]

[[artifacts]]
id = "artifacts/icammda-website"

[[artifacts]]
id = "3B4_FFSkEVBkAeYMFRJ2e"

[[artifacts]]
id = "XegfDyZt7HqfW2Bb8Ghoy"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ICAMMDA Dev Server"

[[workflows.workflow]]
name = "ICAMMDA Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && COREPACK_ENABLE_STRICT=0 pnpm install --frozen-lockfile --prefer-offline 2>/dev/null; PORT=8080 NODE_ENV=production node --enable-source-maps artifacts/api-server/dist/index.mjs"
waitForPort = 8080

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
